@@ -215,6 +215,22 @@
 
 ENDIF()
 
+# Drop requested architectures below AMGX's minimum (sm_70), so that a
+# toolchain-wide default list such as conda-forge's CUDAARCHS can be passed as is.
+set(_amgx_archs "")
+foreach(_arch IN LISTS CMAKE_CUDA_ARCHITECTURES)
+  string(REGEX MATCH "^[0-9]+" _arch_num "${_arch}")
+  if(_arch_num AND _arch_num GREATER_EQUAL 70)
+    list(APPEND _amgx_archs "${_arch}")
+  else()
+    message(STATUS "Skipping unsupported CUDA architecture: ${_arch}")
+  endif()
+endforeach()
+if(NOT _amgx_archs)
+  message(FATAL_ERROR "None of the requested CUDA architectures (${CMAKE_CUDA_ARCHITECTURES}) is supported by AMGX (minimum sm_70)")
+endif()
+set(CMAKE_CUDA_ARCHITECTURES "${_amgx_archs}" CACHE STRING "Target CUDA architectures" FORCE)
+
 # Validate CMAKE_CUDA_ARCHITECTURES against what this CUDA version supports
 message(STATUS "CUDA ${CMAKE_CUDA_COMPILER_VERSION} supports architectures: ${CUDA_ALLOW_ARCH}")
 message(STATUS "Building for architectures: ${CMAKE_CUDA_ARCHITECTURES}")
